{
  "name": "mokshmargprakashak-prop-tokens",
  "version": "1.0.0",
  "source": "docs/v2-development/05-prop-bible.md, section 1",
  "note": "Single source of truth for colour. Every SVG in production/props uses only these hex values. Shade and highlight are made with opacity, never with a new hex.",
  "colors": {
    "outline": "#4A2C20",
    "ink-sepia": "#6E4322",
    "soot-black": "#2A2321",
    "wall-cream": "#F4E8CF",
    "paper-cream": "#FFF8E4",
    "parchment": "#EAD8B1",
    "cotton-white": "#FCFAF4",
    "lamp-gold": "#F5A623",
    "flame-core": "#FFE9A6",
    "phone-blue": "#4DA3F0",
    "day-sky": "#CDE6F0",
    "night-indigo": "#1F2348",
    "rust-shawl": "#B5532B",
    "granth-maroon": "#7A1E2C",
    "haldi-yellow": "#EDB82F",
    "wool-red": "#D2312E",
    "kite-pink": "#EF6FA1",
    "steel": "#BFC8CE",
    "brass": "#C4932F",
    "terracotta": "#C66B3F",
    "wood": "#9A683C",
    "cane-straw": "#CFAE74",
    "leaf-green": "#6B9B3A",
    "bench-green": "#2F6D54",
    "skin-wheat": "#E3B68D",
    "skin-tan": "#C98F63"
  },
  "groups": {
    "line": ["outline", "ink-sepia", "soot-black"],
    "ground": ["wall-cream", "paper-cream", "parchment", "cotton-white", "night-indigo"],
    "light": ["lamp-gold", "flame-core", "phone-blue", "day-sky"],
    "cloth": ["rust-shawl", "granth-maroon", "haldi-yellow", "wool-red", "kite-pink"],
    "material": ["steel", "brass", "terracotta", "wood", "cane-straw", "leaf-green", "bench-green"],
    "skin": ["skin-wheat", "skin-tan"]
  },
  "worlds": {
    "flat": { "ground": "wall-cream", "line": "outline", "light": ["lamp-gold", "phone-blue", "day-sky"] },
    "page": { "ground": "parchment", "line": "ink-sepia", "light": [] },
    "jaipur": { "ground": "night-indigo", "line": "outline", "light": ["lamp-gold"] }
  },
  "gradients": {
    "lamp": { "type": "radial", "stops": [["flame-core", 0], ["lamp-gold", 0.55], ["lamp-gold", 1]], "fadeTo": "transparent" },
    "phone": { "type": "radial", "stops": [["cotton-white", 0], ["phone-blue", 0.6], ["phone-blue", 1]], "fadeTo": "transparent" },
    "daylight": { "type": "linear", "stops": [["day-sky", 0], ["wall-cream", 1]], "fadeTo": "wall-cream" }
  },
  "stroke": {
    "outline": { "color": "outline", "width": 3, "cap": "round", "join": "round", "screenEquivalentPx": 2 },
    "detail": { "color": "outline", "width": 1.5, "cap": "round", "join": "round" },
    "ink": { "color": "ink-sepia", "width": 5, "cap": "round", "join": "round" }
  },
  "overlay": {
    "shade": { "color": "outline", "opacity": 0.16 },
    "highlight": { "color": "cotton-white", "opacity": 0.5 },
    "guide": { "color": "outline", "opacity": 0.45, "dash": "5 5", "note": "placement guides only; never rendered in a shot" }
  },
  "grid": {
    "unitsPerCell": 100,
    "cellViewBox": 400,
    "note": "1 grid unit = 4 viewBox units. Each state of a prop sits in its own cell, laid out left to right."
  },
  "flameAnchor": { "x": 312, "y": 218, "note": "Wick tip in diya-jaipur.svg, diya-ghar.svg and lau.svg cells. A match cut between lamps needs no re-registration." }
}
